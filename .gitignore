# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Expo ────────────────────────────────────────────────────────────────────
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# ─── Native projects ─────────────────────────────────────────────────────────
# Regenerated by `expo prebuild` (Continuous Native Generation). These MUST stay
# untracked: CI regenerates them from app.json on every run, and a committed copy
# would silently build stale native code. See docs/PRD.md §3.2.
ios/
android/

# ─── Build artifacts ─────────────────────────────────────────────────────────
*.ipa
*.apk
*.aab
*.xcarchive
*.dSYM.zip
*.tar.gz
Payload/

# ─── SECRETS — never commit any of these ─────────────────────────────────────
# This repo is PUBLIC. Anything matching below would be world-readable and, once
# pushed, permanently in the git history even if deleted later.
.env
.env.*
!.env.example
secrets.json
credentials.json
*.secret

# Signing material. The whole pipeline is designed so none of this is ever
# needed here (CI builds unsigned; AltStore signs locally with a free Apple ID).
# If one of these ever appears in this folder, something has gone wrong.
*.pem
*.key
*.p8
*.p12
*.pfx
*.cer
*.crt
*.mobileprovision
*.keystore
*.jks

# ─── Tooling caches ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.tsbuildinfo
.eslintcache

# ─── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# ─── Claude Code local state ─────────────────────────────────────────────────
# Skills and agents ARE committed on purpose (they're project infrastructure).
# Only machine-local settings are ignored.
.claude/settings.local.json
