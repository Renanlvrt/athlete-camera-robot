{
    "name": "ble-ping-echo",
    "description": "Echoes any BLE UART data back to the sender, prefixed conceptually by nothing -- raw byte echo, for bench_ping.py to test against.",
    "dependencies": {
        "core": "*",
        "bluetooth": "*"
    },
    "files": [
        "main.ts"
    ],
    "yotta": {
        "config": {
            "microbit-dal": {
                "bluetooth": {
                    "enabled": 1,
                    "open": 1,
                    "pairing_mode": 0,
                    "whitelist": 0,
                    "security_level": null
                }
            }
        }
    }
}
